# Deployment params for the paper-law bridge (loaded via --defaults).
# GUID_OPTIONS=1: allow SET_ATTITUDE_TARGET in GUIDED -- without this bit
# Copter ACCEPTS the message and silently ignores it (the vehicle just hovers;
# measured: phi held ~0 for an entire 1-rad step run).
GUID_OPTIONS	1
# paper references command 57.3 deg per axis (73 deg combined tilt)
ANGLE_MAX	8000
# bare-default SITL has no RC/GCS prearm context
ARMING_CHECK	0
